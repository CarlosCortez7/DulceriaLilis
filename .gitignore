# =====================================
# PYTHON / DJANGO .gitignore
# =====================================

# --- Bytecode and compiled files ---
__pycache__/
*.py[cod]
*$py.class

# --- Virtual Environments ---
# Common names for virtual environments. Add yours if different.
venv/
env/
ENV/
.venv/
.env/
.virtualenv/

# --- Environment variables ---
# Never commit your .env files containing secrets!
.env
*.env

# --- Operating System Files ---
# Ignore macOS .DS_Store files
.DS_Store
# Ignore Windows thumbnail cache files
Thumbs.db
# Ignore Windows desktop configuration files
desktop.ini

# --- IDE / Editor Configuration ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- Log Files ---
*.log
logs/
log/

# --- Temporary Files ---
*.tmp
*.bak
*.swp
*.~

# --- Build / Distribution Artifacts ---
build/
dist/
*.egg-info/
*.egg

# --- Local Database Files ---
# Ignore SQLite database used for development
db.sqlite3
db.sqlite3-journal

# --- Django Migrations ---
# It's generally RECOMMENDED to commit migrations.
# They track your database schema changes. Uncomment below ONLY
# if you have a specific reason NOT to version them (usually not advised).
# */migrations/*.py
# !*/migrations/__init__.py

# --- Django Static Files ---
# Ignore the directory where 'collectstatic' gathers files for production.
staticfiles/
# NOTE: Do NOT ignore your project's main 'static/' directory,
# as it contains your source CSS, JS, and image files needed in the repo.

# --- Django Media Files ---
# Ignore the directory where user-uploaded files are stored.
media/

# --- Test / Coverage Reports ---
.coverage
.coverage.*
htmlcov/
pytest_cache/
.pytest_cache/

# --- Security sensitive files ---
*.key
*.pem
*.cer
*.crt

# --- Other Tooling ---
.cache/
.tox/
.nox/